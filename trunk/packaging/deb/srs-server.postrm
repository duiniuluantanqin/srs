#!/bin/sh
set -e

case "$1" in
  purge)
    rm -rf /run/srs-server.* /var/log/srs-server /etc/srs-server /usr/share/doc/examples/srs-server/html
    ;;

  remove|disappear|upgrade|failed-upgrade|abort-install|abort-upgrade)
    ;;

  *)
    echo "postrm called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0

